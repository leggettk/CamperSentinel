+void SettingsPage::handleConnectivitySave()
+{
+    if (server_ == nullptr ||
+        settings_ == nullptr)
+    {
+        return;
+    }
+
+    if (!server_->hasArg("wifiSSID"))
+    {
+        server_->send(
+            400,
+            "text/plain; charset=utf-8",
+            "Wi-Fi SSID is missing.");
+
+        return;
+    }
+
+    String ssid =
+        server_->arg("wifiSSID");
+
+    String password =
+        server_->arg("wifiPassword");
+
+    ssid.trim();
+
+    if (ssid.length() > 32)
+    {
+        server_->send(
+            400,
+            "text/plain; charset=utf-8",
+            "Wi-Fi SSID must be 32 characters or fewer.");
+
+        return;
+    }
+
+    if (password.length() > 64)
+    {
+        server_->send(
+            400,
+            "text/plain; charset=utf-8",
+            "Wi-Fi password is too long.");
+
+        return;
+    }
+
+    DeviceSettings& config =
+        settings_->get();
+
+    config.wifiEnabled =
+        server_->hasArg("wifiEnabled");
+
+    config.wifiSSID =
+        ssid;
+
+    // Blank means keep the existing password.
+    if (password.length() > 0)
+    {
+        config.wifiPassword =
+            password;
+    }
+
+    if (!settings_->save())
+    {
+        if (logger_ != nullptr)
+        {
+            logger_->error(
+                "Failed to save connectivity settings");
+        }
+
+        server_->send(
+            500,
+            "text/plain; charset=utf-8",
+            "Failed to save connectivity settings.");
+
+        return;
+    }
+
+    if (logger_ != nullptr)
+    {
+        logger_->info(
+            String("Wi-Fi settings saved: SSID=") +
+            config.wifiSSID +
+            ", WiFi=" +
+            (config.wifiEnabled
+                ? "enabled"
+                : "disabled"));
+    }
+
+    server_->sendHeader(
+        "Location",
+        "/settings/connectivity?saved=1");
+
+    server_->send(
+        303,
+        "text/plain",
+        "");
+}
+void SettingsPage::handleMqttSave()
+{
+    if (server_ == nullptr ||
+        settings_ == nullptr)
+    {
+        return;
+    }
+
+    if (!server_->hasArg("mqttHost") ||
+        !server_->hasArg("mqttPort"))
+    {
+        server_->send(
+            400,
+            "text/plain; charset=utf-8",
+            "Required MQTT settings are missing.");
+
+        return;
+    }
+
+    String host =
+        server_->arg("mqttHost");
+
+    String username =
+        server_->arg("mqttUsername");
+
+    String password =
+        server_->arg("mqttPassword");
+
+    host.trim();
+    username.trim();
+
+    const long port =
+        server_->arg("mqttPort").toInt();
+
+    if (host.length() > 128)
+    {
+        server_->send(
+            400,
+            "text/plain; charset=utf-8",
+            "MQTT broker hostname is too long.");
+
+        return;
+    }
+
+    if (port < 1 ||
+        port > 65535)
+    {
+        server_->send(
+            400,
+            "text/plain; charset=utf-8",
+            "MQTT port must be between 1 and 65535.");
+
+        return;
+    }
+
+    if (username.length() > 64)
+    {
+        server_->send(
+            400,
+            "text/plain; charset=utf-8",
+            "MQTT username is too long.");
+
+        return;
+    }
+
+    if (password.length() > 128)
+    {
+        server_->send(
+            400,
+            "text/plain; charset=utf-8",
+            "MQTT password is too long.");
+
+        return;
+    }
+
+    DeviceSettings& config =
+        settings_->get();
+
+    config.mqttEnabled =
+        server_->hasArg("mqttEnabled");
+
+    config.mqttHost =
+        host;
+
+    config.mqttPort =
+        static_cast<uint16_t>(port);
+
+    config.mqttUsername =
+        username;
+
+    config.mqttTlsEnabled =
+        server_->hasArg("mqttTlsEnabled");
+
+    // Blank means preserve the currently stored password.
+    if (!password.isEmpty())
+    {
+        config.mqttPassword =
+            password;
+    }
+
+    if (!settings_->save())
+    {
+        if (logger_ != nullptr)
+        {
+            logger_->error(
+                "Failed to save MQTT settings");
+        }
+
+        server_->send(
+            500,
+            "text/plain; charset=utf-8",
+            "Failed to save MQTT settings.");
+
+        return;
+    }
+
+    if (logger_ != nullptr)
+    {
+        logger_->info(
+            String("MQTT settings saved: host=") +
+            config.mqttHost +
+            ", port=" +
+            String(config.mqttPort) +
+            ", TLS=" +
+            (config.mqttTlsEnabled
+                ? "enabled"
+                : "disabled"));
+    }
+
+    server_->sendHeader(
+        "Location",
+        "/settings/connectivity?mqttSaved=1");
+
+    server_->send(
+        303,
+        "text/plain",
+        "");
+}
