+                entry.uptimeSeconds);
+
+        String value =
+            "[" +
+            eventLevelName(entry.level) +
+            "] " +
+            entry.message;
+
+        page.addValue(
+            label,
+            value);
+    }
+}
+
+page.endCard();
+
+    server_->send(
+        200,
+        "text/html; charset=utf-8",
+        page.build());
+}
+
+String DiagnosticsPage::formatUptime(
+    uint32_t totalSeconds) const
+{
+    const uint32_t days =
+        totalSeconds / 86400UL;
+
+    totalSeconds %= 86400UL;
+
+    const uint8_t hours =
+        totalSeconds / 3600UL;
+
+    totalSeconds %= 3600UL;
+
+    const uint8_t minutes =
+        totalSeconds / 60UL;
+
+    const uint8_t seconds =
+        totalSeconds % 60UL;
+
+    char buffer[40];
+
+    snprintf(
+        buffer,
+        sizeof(buffer),
+        "%lu d %02u:%02u:%02u",
+        static_cast<unsigned long>(days),
+        hours,
+        minutes,
+        seconds);
+
+    return String(buffer);
+}
+String DiagnosticsPage::eventLevelName(
+    EventLevel level) const
+{
+    switch (level)
+    {
+        case EventLevel::Info:
+            return "INFO";
+
+        case EventLevel::Warning:
+            return "WARN";
+
+        case EventLevel::Error:
+            return "ERROR";
+    }
+
+    return "UNKNOWN";
+}
+void DiagnosticsPage::handleClearLog()
+{
+    if (server_ == nullptr)
+    {
+        return;
+    }
+
+    eventLog.clear();
+
+    //
+    // Don't use logger.info() here.
+    // That would immediately put an entry
+    // back into the log we just cleared.
+    //
+
+    server_->sendHeader(
+        "Location",
+        "/diagnostics?logCleared=1");
+
+    server_->send(
+        303,
+        "text/plain",
+        "");
+}
